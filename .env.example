# Required for image and video generation.
FAL_KEY=<your-fal-key>

# Optional. Enables model-specific prompt refinement.
GOOGLE_API_KEY=<your-google-api-key>

# Optional. Third provider options alongside fal (Kie, Wavespeed, HeyGen) —
# each only lights up for the models it has a verified equivalent for
# (see server/server.mjs KIE_EQUIVALENTS / WAVESPEED_EQUIVALENTS /
# HEYGEN_EQUIVALENTS). HeyGen is talking-head only (echomimic-v3,
# infinitalk, latentsync) — see providers/heygen.md in the shot-builder repo.
KIE_API_KEY=<your-kie-api-key>
WAVESPEED_API_KEY=<your-wavespeed-api-key>
HEYGEN_API_KEY=<your-heygen-api-key>

# Optional local reference projects. Bench still runs when these are absent.
BENCH_WEBSITE_REFERENCE=/absolute/path/to/a/reference-website
BENCH_WEBSITE_REFERENCE_URL=http://localhost:5300/
BENCH_DOCUMENT_REFERENCE=/absolute/path/to/a/reference-document.html
